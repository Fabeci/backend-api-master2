# ============================================================================
# SOMAPRO — production. Copier en `.env.prod` sur le serveur (jamais commité).
# ============================================================================
DJANGO_SECRET_KEY=CHANGER-64-CARACTERES-ALEATOIRES
DEBUG=False
ALLOWED_HOSTS=somaproapi.gconnectapp.com
CORS_ALLOWED_ORIGINS=https://somapro.gconnectapp.com,https://somaproapi.gconnectapp.com
CSRF_TRUSTED_ORIGINS=https://somapro.gconnectapp.com,https://somaproapi.gconnectapp.com

# Base de données
POSTGRES_DB=somapro
POSTGRES_USER=somapro
POSTGRES_PASSWORD=CHANGER-MOT-DE-PASSE-FORT

# Institution par défaut (mono-établissement)
DEFAULT_INSTITUTION_ID=27

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@gconnectapp.com

# IA (optionnel)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
