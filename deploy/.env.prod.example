# ============================================================================
# SOMAPRO — production. Copier en `.env.prod` sur le serveur (jamais commité).
# ============================================================================
DJANGO_SECRET_KEY=CHANGER-64-CARACTERES-ALEATOIRES
DEBUG=False
ALLOWED_HOSTS=somaproapi.gconnectapp.com
CORS_ALLOWED_ORIGINS=https://somapro.gconnectapp.com,https://somaproapi.gconnectapp.com
CSRF_TRUSTED_ORIGINS=https://somapro.gconnectapp.com,https://somaproapi.gconnectapp.com

# Base de données
POSTGRES_DB=somapro
POSTGRES_USER=somapro
POSTGRES_PASSWORD=CHANGER-MOT-DE-PASSE-FORT

# Institution par défaut (mono-établissement)
DEFAULT_INSTITUTION_ID=27

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@gconnectapp.com

# IA — Ollama local (service `ollama` du compose)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=30m
AI_TIMEOUT=180
AI_OFFLINE_FALLBACK=False

# Transcription locale (faster-whisper) pour le RAG vidéo/audio.
# tiny = rapide ; base/small = meilleure qualité mais plus lourd.
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=fr
WHISPER_MAX_DURATION=900
WHISPER_CACHE_DIR=/models/whisper

# Fournisseurs cloud optionnels (si AI_PROVIDER change)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
