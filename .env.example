# ⚠️ Copier ce fichier vers .env et renseigner les valeurs réelles.
# Ne JAMAIS committer .env (déjà ignoré par Git).

DJANGO_SECRET_KEY=change-me-generate-a-64-char-secret
DEBUG=False
DEFAULT_INSTITUTION_ID=27
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Base / Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Email (réinitialisation / activation)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# IA (ollama | claude | gemini | openai | mistral | mock)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_NUM_CTX=4096
AI_TIMEOUT=60
AI_MAX_TOKENS=2048
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Google Meet / Calendar
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Microsoft Teams (Graph)
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_ORGANIZER=
